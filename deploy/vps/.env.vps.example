# VPS environment — copy to .env.vps and fill in real values
# NEVER commit .env.vps to version control.

# ── Postgres ─────────────────────────────────────────────────
DB_USER=mango
DB_PASSWORD=CHANGE_ME
DB_NAME=mango
DATABASE_URL=postgresql+psycopg2://mango:CHANGE_ME@db:5432/mango

# ── Flask ────────────────────────────────────────────────────
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_use_python_secrets_token_hex_32
SESSION_SECURE=1

# ── Auth ─────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=your-admin@yourdomain.com
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
AUTH_DISABLED=0

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Ingest API Key ───────────────────────────────────────────
# python3 -c "import secrets; print(secrets.token_hex(16))"
INGEST_API_KEY=CHANGE_ME_use_python_secrets_token_hex_16

# ── SMTP ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME@gmail.com
SMTP_PASSWORD=CHANGE_ME_app_password
CONTACT_RECIPIENTS=your-email@yourdomain.com

# ── Gunicorn ─────────────────────────────────────────────────
# Formula: (2 × CPU cores) + 1. For a 2-core VPS use 4 or 5.
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_PRELOAD=true

# ── SQLAlchemy connection pool ────────────────────────────────
# POOL_SIZE × workers connections kept open to Postgres at all times.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ── Networking ───────────────────────────────────────────────
PUBLIC_BASE_URL=https://yourdomain.com
API_HOST_PORT=8000

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME
GRAFANA_ROOT_URL=https://yourdomain.com/grafana/
