# VPS environment — copy to .env.vps and fill in real values

# Postgres
DB_USER=mango
DB_PASSWORD=CHANGE_ME
DB_NAME=mango

# App
SECRET_KEY=CHANGE_ME_use_python_secrets_token_hex_32
DATABASE_URL=postgresql+psycopg2://mango:CHANGE_ME@db:5432/mango
REDIS_URL=redis://redis:6379/0

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_PRELOAD=true

# Lovable auth
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD_HASH=CHANGE_ME_generate_with_werkzeug
AUTH_DISABLED=0

# Ingest protection
INGEST_API_KEY=CHANGE_ME_use_python_secrets_token_hex_16

# Public domain
PUBLIC_BASE_URL=https://integramosoe.com
API_HOST_PORT=8000