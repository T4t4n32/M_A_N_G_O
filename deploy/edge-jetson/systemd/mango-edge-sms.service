[Unit]
Description=MANGO Edge — SMS alert dispatcher (Huawei E3372H-153)
After=network-online.target mango-edge-serial.service
Wants=network-online.target
BindsTo=mango-edge-serial.service

[Service]
Type=simple
User=mango
WorkingDirectory=/opt/mango_node
EnvironmentFile=/opt/mango_node/.env
ExecStart=/usr/bin/python3 -m mango_node.sms_dispatch
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
