[Unit]
Description=MANGO Edge — serial acquisition (ESP32 → SQLite)
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
User=mango
WorkingDirectory=/opt/mango_node
EnvironmentFile=/opt/mango_node/.env
ExecStart=/usr/bin/python3 -m mango_node.serial_acquire
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target