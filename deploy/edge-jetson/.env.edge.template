# M.A.N.G.O. Edge node environment — copy to /opt/mango/.env and fill in values
# Never commit the filled file.

# ── Identity ──────────────────────────────────────────────────────────────────
DEVICE_ID=mango-field-unit-01
MANGO_STATION_NAME=MANGO-TK1-01

# ── VPS connection ────────────────────────────────────────────────────────────
VPS_URL=https://integramosoe.com
INGEST_API_KEY=656c61e55ade92cb49e73a56f72e5c7d

# ── Paths ─────────────────────────────────────────────────────────────────────
DB_PATH=/opt/mango/edge.db
MISSION_DIR=/opt/mango/missions

# ── Local API ─────────────────────────────────────────────────────────────────
EDGE_API_PORT=9100
EDGE_API_URL=http://localhost:9100

# ── Serial (ESP32) ────────────────────────────────────────────────────────────
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=115200

# ── Sync ─────────────────────────────────────────────────────────────────────
SYNC_INTERVAL=30

# ── Mission state machine ─────────────────────────────────────────────────────
SM_POLL_S=2
# BUTTON_GPIO=18    # BCM pin for physical button (optional)

# ── SSH reverse tunnel ────────────────────────────────────────────────────────
MANGO_VPS_HOST=integramosoe.com
MANGO_VPS_USER=mango
MANGO_VPS_SSH_PORT=5972
MANGO_TUNNEL_RPORT=9200
MANGO_SSH_KEY=/home/ubuntu/.ssh/id_rsa_tunnel

# ── Logging ───────────────────────────────────────────────────────────────────
MANGO_VERBOSE=1
