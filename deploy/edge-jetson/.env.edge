# Edge node — Jetson TK1
STATION_NAME=MANGO-TK1-01

# Serial (ESP32 USB)
MANGO_SERIAL_PORT=/dev/ttyUSB0
MANGO_SERIAL_BAUDRATE=115200

# VPS target
MANGO_API_URL=https://integramosoe.com/api/v1/ingest
MANGO_API_KEY=CHANGE_ME_same_as_INGEST_API_KEY

# Local spool
MANGO_DB_PATH=/opt/mango_node/mango_node.db

# Connectivity
MANGO_WIFI_IFACES=wlan0
MANGO_LTE_IFACES=usb0,eth1,wwan0

# LoRa (nivel 2) — activar cuando tengas hardware LoRa en el Jetson
MANGO_ENABLE_LORA=0

MANGO_SYNC_INTERVAL=8
MANGO_HTTP_BATCH_SIZE=50
MANGO_VERBOSE=1