# M.A.N.G.O. — Jetson TK1 edge node environment
# Copy this file to /opt/mango_node/.env and fill in real values.
# Never commit the real .env file.

# ---------------------------------------------------------------------------
# Station identity
# ---------------------------------------------------------------------------
MANGO_STATION_NAME=MANGO-TK1-01

# ---------------------------------------------------------------------------
# Backend connectivity
# ---------------------------------------------------------------------------
# Full URL of the ingest endpoint on your backend VPS.
MANGO_API_URL=https://integramosoe.com/api/v1/ingest

# API key for ingest and alert config endpoints.
# Must match INGEST_API_KEY on the backend.
MANGO_API_KEY=change_me_to_a_strong_random_key

# ---------------------------------------------------------------------------
# Serial (ESP32 → Jetson)
# ---------------------------------------------------------------------------
# USB serial port where the ESP32 is connected.
# Usually /dev/ttyUSB0 or /dev/ttyACM0 on the Jetson TK1.
MANGO_SERIAL_PORT=/dev/ttyUSB0
MANGO_SERIAL_BAUDRATE=115200
MANGO_SERIAL_TIMEOUT=1.0
MANGO_READ_INTERVAL=0.5

# ---------------------------------------------------------------------------
# Sync manager
# ---------------------------------------------------------------------------
MANGO_SYNC_INTERVAL=8.0
MANGO_HTTP_BATCH_SIZE=50
MANGO_DB_PATH=/opt/mango_node/mango_node.db

# ---------------------------------------------------------------------------
# Network interfaces
# ---------------------------------------------------------------------------
# Comma-separated list of interface names to check for Wi-Fi connectivity.
MANGO_WIFI_IFACES=wlan0

# Comma-separated list of interface names used by the Huawei E3372H-153.
# The modem appears as an Ethernet-over-USB device (lte0 after udev rename).
MANGO_LTE_IFACES=lte0,usb0,eth1

# Set to 1 only if a LoRa transceiver is physically present.
MANGO_ENABLE_LORA=0

# ---------------------------------------------------------------------------
# SMS alert dispatcher
# ---------------------------------------------------------------------------
# Set to 0 to disable SMS without stopping the service.
MANGO_SMS_ENABLED=1

# IP of the Huawei E3372H-153 in HiLink mode (default gateway).
MANGO_HUAWEI_GATEWAY=192.168.8.1

# Minimum seconds between SMS per sensor type + alert level.
# 1800 = 30 minutes. Prevents SMS flooding during sustained anomalies.
MANGO_SMS_COOLDOWN_S=1800

# How often (seconds) to refresh alert rules and contacts from the backend.
MANGO_SMS_CONFIG_REFRESH_S=900

# How often (seconds) to check local DB for new alert measurements.
MANGO_SMS_POLL_S=15

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
MANGO_VERBOSE=1
