# M.A.N.G.O. — Jetson edge node environment
# Copy to /opt/mango_node/.env and fill in real values.
# Never commit the real .env file.

# ---------------------------------------------------------------------------
# Device / station identity
# ---------------------------------------------------------------------------
# Stable name for the deployment location (sent to backend as station.name)
MANGO_STATION_NAME=MANGO-TK1-01

# Unique identifier for this hardware unit (used in packet_id generation)
# Format: mango-<role>-<unit>
# Examples: mango-jetson-01, mango-sensor-esp32-01
MANGO_DEVICE_ID=mango-jetson-01

# ---------------------------------------------------------------------------
# Backend connectivity
# ---------------------------------------------------------------------------
# Full URL of the ingest endpoint on your VPS backend.
# Primary:  POST /api/v1/ingest/batch  (batch, with deduplication)
# Fallback: POST /api/v1/ingest        (single packet)
MANGO_API_URL=https://integramosoe.com/api/v1/ingest

# API key for ingest, sync, and alert-config endpoints.
# Must match INGEST_API_KEY on the backend.
MANGO_API_KEY=change_me_to_a_strong_random_key

# ---------------------------------------------------------------------------
# Serial (ESP32 sensors -> Jetson)
# ---------------------------------------------------------------------------
MANGO_SERIAL_PORT=/dev/ttyUSB0
MANGO_SERIAL_BAUDRATE=115200
MANGO_SERIAL_TIMEOUT=1.0
MANGO_READ_INTERVAL=0.5

# ---------------------------------------------------------------------------
# Sync manager (store-and-forward outbox)
# ---------------------------------------------------------------------------
MANGO_SYNC_INTERVAL=8.0
MANGO_HTTP_BATCH_SIZE=50
MANGO_DB_PATH=/opt/mango_node/mango_node.db

# ---------------------------------------------------------------------------
# Local HTTP API (read-only, LAN only, port 9100)
# GET /health  /api/latest  /api/stats  /edge/queue  /edge/sync-status  /edge/imu/latest
# ---------------------------------------------------------------------------
MANGO_LOCAL_API_PORT=9100

# ---------------------------------------------------------------------------
# Network interfaces
# ---------------------------------------------------------------------------
MANGO_WIFI_IFACES=wlan0
MANGO_LTE_IFACES=lte0,usb0,eth1

# Set to 1 only if a LoRa transceiver is physically connected to the Jetson
MANGO_ENABLE_LORA=0

# ---------------------------------------------------------------------------
# SMS alert dispatcher (Huawei E3372H-153 in HiLink mode)
# ---------------------------------------------------------------------------
MANGO_SMS_ENABLED=1
MANGO_HUAWEI_GATEWAY=192.168.8.1
MANGO_SMS_COOLDOWN_S=1800
MANGO_SMS_CONFIG_REFRESH_S=900
MANGO_SMS_POLL_S=15

# ---------------------------------------------------------------------------
# Reverse SSH tunnel (mango-hub / mango-tunnel service)
# The Jetson opens a tunnel to the VPS on boot so the VPS can reach it
# even when the LTE IP changes.  From the VPS: ssh -p 9200 mango@localhost
# ---------------------------------------------------------------------------
MANGO_VPS_HOST=integramosoe.com
MANGO_VPS_USER=mango
MANGO_VPS_SSH_PORT=22
MANGO_TUNNEL_RPORT=9200
MANGO_SSH_KEY=/home/mango/.ssh/id_rsa_tunnel

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
MANGO_VERBOSE=1
