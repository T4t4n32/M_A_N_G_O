# Gateway environment — copy to /opt/mango_gateway/.env and fill in real values

# Serial port where the LoRa RX ESP32 is connected
SERIAL_PORT=/dev/ttyUSB0
BAUDRATE=115200

# VPS backend ingest endpoint
API_URL=https://integramosoe.com/api/v1/ingest

# Must match INGEST_API_KEY on the VPS backend
INGEST_API_KEY=CHANGE_ME

STATION_NAME=MANGO Station

# Logging
LOG_RAW=0
LOG_SEND=1
LOG_EVERY_N=25
DROP_NEG1=0

# Local API on this machine (for health checks)
LOCAL_API_PORT=9100
ENABLE_LOCAL_API=1
