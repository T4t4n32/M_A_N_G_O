[#] systemd unit file to run the sync manager process

[Unit]
Description=MANGO Node: synchronisation manager for uploading sensor data
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mango_node
EnvironmentFile=-/opt/mango_node/.env
ExecStart=/usr/bin/python3 -m mango_node.sync_manager
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target