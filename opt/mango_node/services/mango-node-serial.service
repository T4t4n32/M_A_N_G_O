[#] systemd unit file to run the serial acquisition process

[Unit]
Description=MANGO Node: serial acquisition of sensor readings
After=local-fs.target

[Service]
Type=simple
# Change the WorkingDirectory to the install location of the mango node
WorkingDirectory=/opt/mango_node
ExecStart=/usr/bin/python3 -m mango_node.serial_acquire
Restart=always
RestartSec=3
# Ensure output is not buffered so logs appear promptly
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target