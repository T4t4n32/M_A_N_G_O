[#] systemd unit file to run the serial acquisition process

[Unit]
Description=MANGO Node: serial acquisition of sensor readings
After=local-fs.target

[Service]
Type=simple
WorkingDirectory=/opt
EnvironmentFile=-/opt/mango_node/.env
ExecStart=/usr/bin/python3 -m mango_node.serial_acquire
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target