[Unit]
Description=MANGO Node: Huawei E3372H-153 modem watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mango_node
EnvironmentFile=-/opt/mango_node/.env
ExecStart=/usr/bin/python3 -m mango_node.modem_monitor
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
