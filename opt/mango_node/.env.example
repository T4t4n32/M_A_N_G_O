# M.A.N.G.O. Node — Jetson TK1 configuration
# Copy to /opt/mango_node/.env and fill in real values before starting services.

# ── Identity ──────────────────────────────────────────────────────────────────
MANGO_STATION_NAME=MANGO-TK1-01
MANGO_DEVICE_ID=MANGO-TK1-01

# ── Backend connection ────────────────────────────────────────────────────────
MANGO_API_URL=https://integramosoe.com/api/v1/ingest
MANGO_API_KEY=your-ingest-api-key-here

# ── Serial port (ESP32 sensor node) ──────────────────────────────────────────
MANGO_SERIAL_PORT=/dev/ttyUSB0
MANGO_SERIAL_BAUDRATE=115200
MANGO_SERIAL_TIMEOUT=1.0

# ── Timing ────────────────────────────────────────────────────────────────────
MANGO_READ_INTERVAL=0.5
MANGO_SYNC_INTERVAL=8.0
MANGO_HTTP_BATCH_SIZE=50

# ── Storage ───────────────────────────────────────────────────────────────────
MANGO_DB_PATH=/opt/mango_node/mango_node.db

# ── Network interface detection ───────────────────────────────────────────────
# Comma-separated list of known Wi-Fi and LTE interface names.
# The E3372H-153 in HiLink mode typically appears as usb0 or eth1.
MANGO_WIFI_IFACES=wlan0
MANGO_LTE_IFACES=usb0,wwan0,eth1

# ── LoRa fallback (disabled by default on Jetson) ────────────────────────────
MANGO_ENABLE_LORA=0

# ── Logging ───────────────────────────────────────────────────────────────────
MANGO_VERBOSE=1

# ── Huawei E3372H-153 modem ──────────────────────────────────────────────────
# Gateway IP of the modem in HiLink mode (default 192.168.8.1).
MANGO_HUAWEI_GATEWAY=192.168.8.1

# ── SMS alerts ────────────────────────────────────────────────────────────────
MANGO_SMS_ENABLED=1
MANGO_SMS_COOLDOWN_S=1800
MANGO_SMS_CONFIG_REFRESH_S=900
MANGO_SMS_POLL_S=15

# ── Modem watchdog ────────────────────────────────────────────────────────────
# How often the watchdog polls the modem (seconds).
MANGO_MODEM_POLL_S=30
# How often the watchdog posts telemetry to the VPS backend (seconds).
MANGO_MODEM_TELEMETRY_S=120
# Path where the modem status JSON sidecar is written.
MANGO_MODEM_STATUS_FILE=/opt/mango_node/modem_status.json
# Delay after triggering a reconnect or USB reset (seconds).
MANGO_MODEM_RECONNECT_DELAY_S=15
# Number of consecutive poll failures before attempting USB reset.
MANGO_MODEM_MAX_FAILURES=3

# ── Local HTTP API ────────────────────────────────────────────────────────────
MANGO_LOCAL_API_PORT=9100
