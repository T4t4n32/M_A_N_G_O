# .env.docker

# ===== DB (dentro de docker network) =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mango_local
POSTGRES_USER=mango_user
POSTGRES_PASSWORD=local_password
DATABASE_URL=postgresql://mango_user:local_password@postgres:5432/mango_local

# ===== REDIS (dentro de docker network) =====
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TIMEZONE=UTC

# ===== FLASK/API =====
API_HOST=0.0.0.0
API_PORT=5000
SECRET_KEY=local-dev-secret-key-change-in-production
DEBUG=False
