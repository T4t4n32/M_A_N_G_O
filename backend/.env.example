# ============================================================
# M.A.N.G.O. Backend — Environment Variables
# Copy this file to .env in the project root and fill real values.
# Never commit .env to version control.
# ============================================================

# Database credentials (used by Postgres container and backend)
DB_USER=mango
DB_PASSWORD=CHANGE_THIS_DB_PASSWORD
DB_NAME=mango
DATABASE_URL=postgresql+psycopg2://mango:CHANGE_THIS_DB_PASSWORD@db:5432/mango

# Flask session secret — use a long random string (32+ chars)
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Session cookie security: set to "1" when serving over HTTPS (always in production)
SESSION_SECURE=1

# SMTP — contact form email delivery
# For Gmail: enable 2FA and create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
CONTACT_RECIPIENTS=histsoluciones@gmail.com

# Port the backend binds on the host (nginx proxies to this)
API_HOST_PORT=8000

# Gunicorn workers (2 * CPU + 1 recommended)
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60

# Optional: single admin account via env (fallback if DB has no users)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
AUTH_DISABLED=0

# Grafana
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD
GRAFANA_ROOT_URL=https://your-domain.com/grafana/
