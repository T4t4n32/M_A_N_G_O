# ============================================================
# M.A.N.G.O. Backend — Environment Variables
# Copy this file to .env and fill real values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_USER=mango
DB_PASSWORD=CHANGE_THIS_DB_PASSWORD
DB_NAME=mango
DATABASE_URL=postgresql+psycopg2://mango:CHANGE_THIS_DB_PASSWORD@db:5432/mango

# ── Flask ────────────────────────────────────────────────────
# Long random secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Set to "1" when serving over HTTPS (always in production)
SESSION_SECURE=1

# ── Auth ─────────────────────────────────────────────────────
# Email address that must be used for the very first registration (becomes super-admin)
SUPER_ADMIN_EMAIL=your-admin@yourdomain.com

# Optional single-account fallback via env (lovable_auth.py — not the main auth path)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
AUTH_DISABLED=0

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Ingest API Key ───────────────────────────────────────────
# Shared secret for edge-node ingest endpoints — generate with:
# python3 -c "import secrets; print(secrets.token_hex(16))"
INGEST_API_KEY=CHANGE_THIS_INGEST_KEY
# Local development only: set to 1 to bypass ingest authentication.
INGEST_ALLOW_ANONYMOUS=0

# ── SMTP — contact form ──────────────────────────────────────
# Gmail: enable 2FA, then create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
CONTACT_RECIPIENTS=your-email@yourdomain.com

# ── Gunicorn ─────────────────────────────────────────────────
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_PRELOAD=true

# ── Networking ───────────────────────────────────────────────
# Port the backend container exposes on the host (127.0.0.1 only)
API_HOST_PORT=8000

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD
GRAFANA_ROOT_URL=https://yourdomain.com/grafana/
