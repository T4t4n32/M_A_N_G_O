# ============================================================
# M.A.N.G.O. Backend — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ============================================================

# CHANGE_BEFORE_PRODUCTION: Use a long random string (32+ chars).
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Database URL. Default: SQLite in the backend folder.
# CHANGE_BEFORE_PRODUCTION: Replace with PostgreSQL URL for production.
DATABASE_URL=sqlite:///mango.db

# Serial port for sensor hardware.
# Linux: /dev/ttyACM0   Windows: COM3
SERIAL_PORT=/dev/ttyACM0

# CORS: exact origin of the frontend (no trailing slash).
# CHANGE_BEFORE_PRODUCTION: Set to the real production domain.
FRONTEND_ORIGIN=http://localhost:3000

# Flask environment: development | production
FLASK_ENV=development
