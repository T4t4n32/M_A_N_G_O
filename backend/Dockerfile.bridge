FROM python:3.12-slim

WORKDIR /app

# Dependencias mínimas para logs/requests/serial y healthcheck si lo necesitas luego
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Reusa requirements si ya trae requests/pyserial.
# Si no los trae, agrégalos a backend/requirements.txt (requests, pyserial).
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY lora_http_bridge.py /app/lora_http_bridge.py

CMD ["python", "/app/lora_http_bridge.py"]
