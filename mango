#!/bin/sh
set -eu

BASE="compose.yaml"
RX="compose.rx.yaml"

need() { command -v "$1" >/dev/null 2>&1 || { echo "[mango] Falta '$1'"; exit 1; }; }

dc() { docker compose -f "$BASE" "$@"; }
dcx() { docker compose -f "$BASE" -f "$RX" "$@"; }

up() { dc up -d --build; }
down() { dc down --remove-orphans; }
purge() { dc down --remove-orphans --volumes; }

dummy_on() { dcx --profile dummy up -d --build bridge_dummy; echo "[mango] dummy ON"; }
dummy_off() { dcx --profile dummy stop bridge_dummy >/dev/null 2>&1 || true; dcx --profile dummy rm -f bridge_dummy >/dev/null 2>&1 || true; echo "[mango] dummy OFF"; }

doctor() {
  need curl
  echo "[mango] UI:   http://localhost:${NGINX_HTTP_PORT:-8080}/"
  echo "[mango] API:  http://localhost:${API_HOST_PORT:-8000}/api/v1/health"
  printf "[mango] health: "
  curl -fsS "http://localhost:${API_HOST_PORT:-8000}/api/v1/health" >/dev/null 2>&1 && echo OK || echo FAIL
  printf "[mango] latest: "
  curl -fsS "http://localhost:${NGINX_HTTP_PORT:-8080}/api/v1/latest/by_type" >/dev/null 2>&1 && echo OK || echo FAIL
}

usage() {
  cat <<'USAGE'
Uso:
  ./mango up
  ./mango down
  ./mango purge        # BORRA volúmenes (DB) - cuidado
  ./mango dummy-on     # sin RX/TX
  ./mango dummy-off
  ./mango doctor

URLs:
  UI:   http://localhost:8080/
  API:  http://localhost:8000/api/v1/health
  DATA: http://localhost:8080/api/v1/latest/by_type
USAGE
}

cmd="${1:-}"
case "$cmd" in
  up) need docker; up ;;
  down) need docker; down ;;
  purge) need docker; purge ;;
  dummy-on) need docker; dummy_on ;;
  dummy-off) need docker; dummy_off ;;
  doctor) doctor ;;
  ""|help|-h|--help) usage ;;
  *) echo "[mango] Comando desconocido: $cmd"; usage; exit 1 ;;
esac
