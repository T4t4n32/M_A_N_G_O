#!/usr/bin/env bash
set -euo pipefail

BASE="docker compose -f compose.yaml"
RX="docker compose -f compose.yaml -f compose.rx.yaml"

cmd="${1:-help}"

detect_serial() {
  # Linux: prefer /dev/serial/by-id for stability
  if ls /dev/serial/by-id/* >/dev/null 2>&1; then
    ls -1 /dev/serial/by-id/* | head -n 1
    return 0
  fi
  # fallback common devices
  for d in /dev/ttyUSB0 /dev/ttyACM0 /dev/ttyS0; do
    if [ -e "$d" ]; then echo "$d"; return 0; fi
  done
  return 1
}

case "$cmd" in
  up)
    $BASE up -d --build
    ;;
  down)
    # Stop everything including bridge (without requiring SERIAL_DEVICE)
    SERIAL_DEVICE="${SERIAL_DEVICE:-/dev/null}" $RX down --remove-orphans
    ;;
  ps)
    $BASE ps
    ;;
  logs)
    svc="${2:-}"
    if [ -z "$svc" ]; then
      $BASE logs -f
    else
      $BASE logs -f "$svc"
    fi
    ;;
  test)
    echo "[1/3] Backend direct:"
    curl -fsS http://localhost:8000/health && echo
    echo "[2/3] Nginx:"
    curl -fsS http://localhost:8080/health && echo
    echo "[3/3] Latest:"
    curl -fsS http://localhost:8080/api/v1/latest | head -c 300 && echo
    ;;
  ingest-demo)
    curl -fsS -X POST http://localhost:8080/api/v1/ingest \
      -H "Content-Type: application/json" \
      -d '{"station":{"name":"MANGO Station"},"readings":[{"type":"ph","value":7.1,"unit":"pH"},{"type":"temperature","value":24.6,"unit":"C"},{"type":"turbidity","value":12.2,"unit":"NTU"}]}' \
      && echo
    ;;
  rx-on)
    dev="$(detect_serial || true)"
    if [ -z "${dev:-}" ]; then
      echo "No encontré RX conectado. Conéctalo y vuelve a intentar."
      exit 1
    fi
    export SERIAL_DEVICE="$dev"
    echo "Usando SERIAL_DEVICE=$SERIAL_DEVICE"
    $RX up -d --build bridge
    ;;
  rx-off)
    SERIAL_DEVICE="${SERIAL_DEVICE:-/dev/null}" $RX stop bridge || true
    SERIAL_DEVICE="${SERIAL_DEVICE:-/dev/null}" $RX rm -f bridge || true
    ;;
  help|*)
    cat <<EOF
Uso:
  ./mango up
  ./mango down
  ./mango ps
  ./mango logs [servicio]
  ./mango test
  ./mango ingest-demo
  ./mango rx-on
  ./mango rx-off
EOF
    ;;
esac
