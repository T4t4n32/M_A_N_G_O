        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "mango-postgres" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  sd.ts AS time,\n  sd.value AS \"pH\"\nFROM sensor_data sd\nJOIN sensors s ON sd.sensor_id = s.id\nWHERE s.type = 'ph'\nORDER BY sd.ts DESC\nLIMIT 1",
          "refId": "A"
        }
      ]
