:"6548906c-1451-9b65-40d1-ba256d5180ab","isDefault":false,"is3dModel":false,"name":"SMD_0201_0603Metric","isThumbnail":false,"label":"SMD_0201_0603Metric.kicad_mod","isFootprint":false,"isPcbBoardShape":false,"rawName":"SMD_0201_0603Metric.kicad_mod","fileType":"kicad_mod","storageName":"document_assets/SMD_0201_0603Metric-bef8d4b4-7a72-a4e1-1f63-b0d46bc93e7a.kicad_mod"},"9cac1deb-c0e6-5cf2-a5a6-0f395578fdaa":{"uid":"9cac1deb-c0e6-5cf2-a5a6-0f395578fdaa","isDefault":false,"is3dModel":false,"name":"3DSMD_1206_3216Metric","isThumbnail":false,"label":"3DSMD_1206_3216Metric.step","isPcbBoardShape":false,"isFootprint":false,"rawName":"3DSMD_1206_3216Metric.step","fileType":"step","storageName":"document_assets/3DSMD_1206_3216Metric-64aabd45-db15-9738-c6ed-2173efd3de54.step"},"9018d072-a974-9569-e5a3-5e91d0efc038":{"uid":"9018d072-a974-9569-e5a3-5e91d0efc038","isDefault":false,"is3dModel":false,"name":"SMD_0805_2012Metric","isThumbnail":false,"label":"SMD_0805_2012Metric.kicad_mod","isFootprint":false,"isPcbBoardShape":false,"rawName":"SMD_0805_2012Metric.kicad_mod","fileType":"kicad_mod","storageName":"document_assets/SMD_0805_2012Metric-7887e72c-5c19-640e-8ed1-bbbe6b5a2894.kicad_mod"},"d4db950e-f050-2e81-c2a6-5de437a93046":{"uid":"d4db950e-f050-2e81-c2a6-5de437a93046","isDefault":false,"is3dModel":false,"name":"3DH_AXIAL-P12.7_D3.6","isThumbnail":false,"label":"3DH_AXIAL-P12.7_D3.6.step","isFootprint":false,"isPcbBoardShape":false,"rawName":"3DH_AXIAL-P12.7_D3.6.step","fileType":"step","storageName":"document_assets/3DH_AXIAL-P12.7_D3.6-36d952a4-08cc-9cca-1b3d-7ff444e68764.step"},"a91ca149-e2fc-a0c1-0430-907b648be076":{"uid":"a91ca149-e2fc-a0c1-0430-907b648be076","isDefault":false,"is3dModel":false,"name":"3DV_AXIAL-P5.08_D2.5","isThumbnail":false,"label":"3DV_AXIAL-P5.08_D2.5.step","isFootprint":false,"isPcbBoardShape":false,"rawName":"3DV_AXIAL-P5.08_D2.5.step","fileType":"step","storageName":"document_assets/3DV_AXIAL-P5.08_D2.5-64e83535-7a96-93d4-8ff2-0934a8f6cd88.step"},"c0159464-eed7-7fbb-6f00-0f2dc0dc8dfb":{"uid":"c0159464-eed7-7fbb-6f00-0f2dc0dc8dfb","is3dModel":false,"isDefault":false,"name":"H_AXIAL-P10.16_D2.5","isThumbnail":false,"label":"H_AXIAL-P10.16_D2.5.kicad_mod","isPcbBoardShape":false,"isFootprint":false,"rawName":"R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal.kicad_mod","fileType":"kicad_mod","storageName":"document_assets/R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal-34e05f5c-88d2-b871-689f-c74e9a13e61c.kicad_mod"},"8d4bd501-7438-6e8c-6ca1-dea8403acb34":{"uid":"8d4bd501-7438-6e8c-6ca1-dea8403acb34","isDefault":false,"is3dModel":false,"name":"SMD_0402_1005Metric","isThumbnail":false,"label":"SMD_0402_1005Metric.kicad_mod","isFootprint":false,"isPcbBoardShape":false,"rawName":"SMD_0402_1005Metric.kicad_mod","fileType":"kicad_mod","storageName":"document_assets/SMD_0402_1005Metric-cfd13a75-48bd-cbcb-d958-05574073eea9.kicad_mod"},"15ce152f-72f5-9991-9927-f38f1feac8cf":{"uid":"15ce152f-72f5-9991-9927-f38f1feac8cf","isDefault":false,"is3dModel":false,"name":"3DV_AXIAL-P5.08_D4.5","isThumbnail":false,"label":"3DV_AXIAL-P5.08_D4.5.step","isFootprint":false,"isPcbBoardShape":false,"rawName":"3DV_AXIAL-P5.08_D4.5.step","fileType":"step","storageName":"document_assets/3DV_AXIAL-P5.08_D4.5-b51df9e8-b75c-3522-500a-628ee5427718.step"},"20dcde2a-4b67-93bb-89e3-b53cebef370c":{"uid":"20dcde2a-4b67-93bb-89e3-b53cebef370c","isDefault":false,"is3dModel":false,"name":"3DSMD_MELF_MMB-0207","isThumbnail":false,"label":"3DSMD_MELF_MMB-0207.step","isPcbBoardShape":false,"isFootprint":false,"rawName":"3DSMD_MELF_MMB-0207.step","fileType":"step","storageName":"document_assets/3DSMD_MELF_MMB-0207-17963aba-ca8b-3679-a823-96b311aa731f.step"},"e4d27a78-6961-8b51-f567-df2e46678282":{"uid":"e4d27a78-6961-8b51-f567-df2e46678282","is3dModel":false,"isDefault":false,"name":"3DH_AXIAL-P10.16_D2.5","isThumbnail":false,"label":"3DH_AXIAL-P10.16_D2.5.step","isPcbBoardShape":false,"isFootprint":false,"rawName":"3DH_AXIAL-P10.16_D2.5.step","fileType":"step","storageName":"document_assets/3DH_AXIAL-P10.16_D2.5-9108fda4-782d-257a-5925-1e9bc92cee1b.step"},"380a4391-6f49-da35-8b4d-70bca0b75f0f":{"uid":"380a4391-6f49-da35-8b4d-70bca0b75f0f","is3dModel":false,"isDefault":false,"name":"SMD_0612_1632Metric","isThumbnail":false,"label":"SMD_0612_1632Metric.kicad_mod","isFootprint":false,"isPcbBoardShape":false,"rawName":"SMD_0612_1632Metric.kicad_mod","fileType":"kicad_mod","storageName":"document_assets/SMD_0612_1632Metric-d580a1fc-b250-23e5-93e3-9d3de59b0cd9.kicad_mod"}},"owner_uid":"B9p30ouORsQh3aMbe7GBBaWBkNk1","behaviour_is_derived":false,"name":"5.1kΩ 0603 Resistor","behaviour":"// Howdy 👋.\n// If you are new to writing code in Flux make sure to check out our get started docs: https://docs.flux.ai/reference/introduction \n// We also have a Flux Slack Community in case you need help: https://join.slack.com/t/fluxcommunity/shared_invite/zt-p48n941f-wzQ06kGmuFJ2HXnGYT1JkA \n// To infinity and beyond 🚀 \n\nconst p1TerminalId = \"dff57d78-487b-f832-db06-4405c23ce37c\"; //P1\nconst p2TerminalId = \"880f28ef-cf41-0acc-4a98-ce0afa37b0c2\"; //P2\n\nconst p1Terminal = flux.getNodeById(p1TerminalId, \"elementTerminal\");\nconst p2Terminal = flux.getNodeById(p2TerminalId, \"elementTerminal\");\n\nconst voltageInputNode = flux.createOutputNode(\"v1\");\nconst voltageOutputNode = flux.createOutputNode(\"v2\");\nconst voltageDrop = flux.createOutputNode(\"vdrop\");\nconst powerOutputNode = flux.createOutputNode(\"power\");\nconst amperageOutputNode = flux.createOutputNode(\"current\");\n\n//setup event\nflux.on(\"setup\", () => {\n    const resistance = Number(flux.properties.find((prop) => prop.name === \"Resistance\")?.value || 500);\n    flux.simulationModel =  simModel(resistance);   \n});\n\n// Property was changed event\nflux.on(\"propertyChange\", (event) => {\n    if (event.property_name === \"Resistance\") {\n        flux.notify(event.property_name + \" changed to \" + event.value + \"Ω\", {\n            variant: \"success\",\n        });\n\n        flux.simulationModel =  simModel(Number(event.value));   \n    }\n});\n\n// Calculation Event\nflux.on(\"afterStep\", () => {\n    const resistance = Number(flux.properties.find((prop) => prop.name === \"Resistance\")?.value || 500);\n    \n    // Equation for power = Current.value to the power of 2 multiply by Resistance // I2R\n    const testABC = Number(p1Terminal?.current);\n    const solveForPower = ((Math.pow(testABC, 2) * resistance) * 1000);\n\n    voltageInputNode.name = \"VP1\";\n    voltageInputNode.value = Number(p1Terminal?.voltage);\n    voltageInputNode.unit = \"V\";\n    voltageInputNode.displayInline = false;\n\n    voltageOutputNode.name = \"VP2\";\n    voltageOutputNode.value = Number(p2Terminal?.voltage);\n    voltageOutputNode.unit = \"V\";\n    voltageOutputNode.displayInline = false;\n\n    amperageOutputNode.name = \"Current\";\n    amperageOutputNode.value = Number(p1Terminal?.current);\n    amperageOutputNode.unit = \"A\";\n    amperageOutputNode.displayInline = true;\n\n    powerOutputNode.name = \"calcPower\";\n    powerOutputNode.value = solveForPower;\n    powerOutputNode.unit = \"mW\";\n    powerOutputNode.displayInline = true;\n\n    voltageDrop.name = \"Vdrop\";\n    voltageDrop.unit =\"V\";\n    voltageDrop.value = Number(p2Terminal?.voltage) - Number(p1Terminal?.voltage);\n    voltageDrop.displayInline = true;\n    \n    flux.outputs = [voltageDrop, voltageInputNode, voltageOutputNode, amperageOutputNode, powerOutputNode];\n});\n\nfunction simModel(resistance: number): ResistorSimulationModelConfig {\n    return {\n        type: \"resistor\",\n        resistance: resistance,\n        map_input_to_terminal_uid: p1TerminalId,\n        map_output_to_terminal_uid: p2TerminalId,\n    };\n}\n\nconst footprintNode = flux.getNodeById(\"bd79d98f-3542-c68b-7d08-c8a9fe1b19d2\") as PcbLayoutNode;\nconst modelNode = flux.getNodeById(\"03889df1-6435-acaa-19c8-c65242c5255a\") as PcbLayoutNode;\n\n// This will return array of all assets with file type .kicad_mod\nconst footprintAssetNotSorted = flux.assets.filter((asset) => asset.fileType === \"kicad_mod\").map((asset) => asset.name);\nconst footprintAssetId = footprintAssetNotSorted.sort();\n\n// This will return array of all assets with file type .step\nconst modelAssetIdNotSorted = flux.assets.filter((asset) => asset.fileType === \"step\").map((asset) => asset.name);\nconst modelAssetId = modelAssetIdNotSorted.sort();\n\nif (footprintNode || modelNode) {\n    const assetFootprintRule = footprintNode.rules.find((rule) => rule.key === \"asset\");\n    const assetModelRule = modelNode.rules.find((rule) => rule.key === \"asset\");\n\n    flux.on(\"setup\", () => {\n        const property = flux.properties.find((prop) => prop.name === \"Package\");\n        if (property) {\n            changeFootprintAsset(property.value);\n            changeModelAsset(property.value)\n        }\n    });\n\n// Listen to any change in the Package property, set the footprint and model \n// based on the current package value.\n    flux.on(\"propertyChange\", (event: PropertyChangeEvent) => {\n        if (event.property_name === \"Package\") {\n            changeFootprintAsset(event.value);\n            changeModelAsset(event.value);\n            flux.notify(event.property_name + \" changed to \" + event.value, {\n                variant: \"success\",\n                });\n        }\n    });\n\n    function changeFootprintAsset(propertyValue: any) {\n        if (assetFootprintRule) {\n            switch (propertyValue) {\n            case footprintAssetId[0]: assetFootprintRule.value = footprintAssetId[0]; footprintNode.name = footprintAssetId[0]; break;\n            case footprintAssetId[1]: assetFootprintRule.value = footprintAssetId[1]; footprintNode.name = footprintAssetId[1]; break;\n            case footprintAssetId[2]: assetFootprintRule.value = footprintAssetId[2]; footprintNode.name = footprintAssetId[2]; break;\n            case footprintAssetId[3]: assetFootprintRule.value = footprintAssetId[3]; footprintNode.name = footprintAssetId[3]; break;\n            case footprintAssetId[4]: assetFootprintRule.value = footprintAssetId[4]; footprintNode.name = footprintAssetId[4]; break;\n            case footprintAssetId[5]: assetFootprintRule.value = footprintAssetId[5]; footprintNode.name = footprintAssetId[5]; break;\n            case footprintAssetId[6]: assetFootprintRule.value = footprintAssetId[6]; footprintNode.name = footprintAssetId[6]; break;\n            case footprintAssetId[7]: assetFootprintRule.value = footprintAssetId[7]; footprintNode.name = footprintAssetId[7]; break;\n            case footprintAssetId[8]: assetFootprintRule.value = footprintAssetId[8]; footprintNode.name = footprintAssetId[8]; break;\n            case footprintAssetId[9]: assetFootprintRule.value = footprintAssetId[9]; footprintNode.name = footprintAssetId[9]; break;\n            case footprintAssetId[10]: assetFootprintRule.value = footprintAssetId[10]; footprintNode.name = footprintAssetId[10]; break;\n            case footprintAssetId[11]: assetFootprintRule.value = footprintAssetId[11]; footprintNode.name = footprintAssetId[11]; break;\n            case footprintAssetId[12]: assetFootprintRule.value = footprintAssetId[12]; footprintNode.name = footprintAssetId[12]; break;\n            case footprintAssetId[13]: assetFootprintRule.value = footprintAssetId[13]; footprintNode.name = footprintAssetId[13]; break;\n            case footprintAssetId[14]: assetFootprintRule.value = footprintAssetId[14]; footprintNode.name = footprintAssetId[14]; break;\n            case footprintAssetId[15]: assetFootprintRule.value = footprintAssetId[15]; footprintNode.name = footprintAssetId[15]; break;   \n            case footprintAssetId[16]: assetFootprintRule.value = footprintAssetId[16]; footprintNode.name = footprintAssetId[16]; break;    \n            case footprintAssetId[17]: assetFootprintRule.value = footprintAssetId[17]; footprintNode.name = footprintAssetId[17]; break;\n            case footprintAssetId[18]: assetFootprintRule.value = footprintAssetId[18]; footprintNode.name = footprintAssetId[18]; break;   \n            case footprintAssetId[19]: assetFootprintRule.value = footprintAssetId[19]; footprintNode.name = footprintAssetId[19]; break;  \n            case footprintAssetId[20]: assetFootprintRule.value = footprintAssetId[20]; footprintNode.name = footprintAssetId[20]; break;    \n            case footprintAssetId[21]: assetFootprintRule.value = footprintAssetId[21]; footprintNode.name = footprintAssetId[21]; break;\n            case footprintAssetId[22]: assetFootprintRule.value = footprintAssetId[22]; footprintNode.name = footprintAssetId[22]; break;\n            case footprintAssetId[23]: assetFootprintRule.value = footprintAssetId[23]; footprintNode.name = footprintAssetId[23]; break;\n            case footprintAssetId[24]: assetFootprintRule.value = footprintAssetId[24]; footprintNode.name = footprintAssetId[24]; break;\n            case footprintAssetId[25]: assetFootprintRule.value = footprintAssetId[25]; footprintNode.name = footprintAssetId[25]; break;\n            case footprintAssetId[26]: assetFootprintRule.value = footprintAssetId[26]; footprintNode.name = footprintAssetId[26]; break;\n            case footprintAssetId[27]: assetFootprintRule.value = footprintAssetId[27]; footprintNode.name = footprintAssetId[27]; break;\n            case footprintAssetId[28]: assetFootprintRule.value = footprintAssetId[28]; footprintNode.name = footprintAssetId[28]; break;\n            case footprintAssetId[29]: assetFootprintRule.value = footprintAssetId[29]; footprintNode.name = footprintAssetId[29]; break;\n            case footprintAssetId[30]: assetFootprintRule.value = footprintAssetId[30]; footprintNode.name = footprintAssetId[30]; break;\n            case footprintAssetId[31]: assetFootprintRule.value = footprintAssetId[31]; footprintNode.name = footprintAssetId[31]; break;\n            case footprintAssetId[32]: assetFootprintRule.value = footprintAssetId[32]; footprintNode.name = footprintAssetId[32]; break;                                    \n            default : assetFootprintRule.value = \"SMD_0603_1608Metric\"; footprintNode.name = \"SMD_0603_1608Metric\"; break;\n            }\n        }\n    }\n\n        function changeModelAsset(propertyValue: any) {\n        if (assetModelRule) {\n            switch (propertyValue) {\n            case footprintAssetId[0]: assetModelRule.value = modelAssetId[0]; modelNode.name = modelAssetId[0]; break;\n            case footprintAssetId[1]: assetModelRule.value = modelAssetId[1]; modelNode.name = modelAssetId[1]; break;\n            case footprintAssetId[2]: assetModelRule.value = modelAssetId[2]; modelNode.name = modelAssetId[2]; break;\n            case footprintAssetId[3]: assetModelRule.value = modelAssetId[3]; modelNode.name = modelAssetId[3]; break;\n            case footprintAssetId[4]: assetModelRule.value = modelAssetId[4]; modelNode.name = modelAssetId[4]; break;\n            case footprintAssetId[5]: assetModelRule.value = modelAssetId[5]; modelNode.name = modelAssetId[5]; break;\n            case footprintAssetId[6]: assetModelRule.value = modelAssetId[6]; modelNode.name = modelAssetId[6]; break;\n            case footprintAssetId[7]: assetModelRule.value = modelAssetId[7]; modelNode.name = modelAssetId[7]; break;\n            case footprintAssetId[8]: assetModelRule.value = modelAssetId[8]; modelNode.name = modelAssetId[8]; break;\n            case footprintAssetId[9]: assetModelRule.value = modelAssetId[9]; modelNode.name = modelAssetId[9]; break;\n            case footprintAssetId[10]: assetModelRule.value = modelAssetId[10]; modelNode.name = modelAssetId[10]; break;\n            case footprintAssetId[11]: assetModelRule.value = modelAssetId[11]; modelNode.name = modelAssetId[11]; break;\n            case footprintAssetId[12]: assetModelRule.value = modelAssetId[12]; modelNode.name = modelAssetId[12]; break;\n            case footprintAssetId[13]: assetModelRule.value = modelAssetId[13]; modelNode.name = modelAssetId[13]; break;\n            case footprintAssetId[14]: assetModelRule.value = modelAssetId[14]; modelNode.name = modelAssetId[14]; break;\n            case footprintAssetId[15]: assetModelRule.value = modelAssetId[15]; modelNode.name = modelAssetId[15]; break;   \n            case footprintAssetId[16]: assetModelRule.value = modelAssetId[16]; modelNode.name = modelAssetId[16]; break;    \n            case footprintAssetId[17]: assetModelRule.value = modelAssetId[17]; modelNode.name = modelAssetId[17]; break;\n            case footprintAssetId[18]: assetModelRule.value = modelAssetId[18]; modelNode.name = modelAssetId[18]; break;   \n            case footprintAssetId[19]: assetModelRule.value = modelAssetId[19]; modelNode.name = modelAssetId[19]; break; \n            case footprintAssetId[20]: assetModelRule.value = modelAssetId[20]; modelNode.name = modelAssetId[20]; break;    \n            case footprintAssetId[21]: assetModelRule.value = modelAssetId[21]; modelNode.name = modelAssetId[21]; break;\n            case footprintAssetId[22]: assetModelRule.value = modelAssetId[22]; modelNode.name = modelAssetId[22]; break;\n            case footprintAssetId[23]: assetModelRule.value = modelAssetId[23]; modelNode.name = modelAssetId[23]; break;\n            case footprintAssetId[24]: assetModelRule.value = modelAssetId[24]; modelNode.name = modelAssetId[24]; break;\n            case footprintAssetId[25]: assetModelRule.value = modelAssetId[25]; modelNode.name = modelAssetId[25]; break;\n            case footprintAssetId[26]: assetModelRule.value = modelAssetId[26]; modelNode.name = modelAssetId[26]; break;\n            case footprintAssetId[27]: assetModelRule.value = modelAssetId[27]; modelNode.name = modelAssetId[27]; break;\n            case footprintAssetId[28]: assetModelRule.value = modelAssetId[28]; modelNode.name = modelAssetId[28]; break;\n            case footprintAssetId[29]: assetModelRule.value = modelAssetId[29]; modelNode.name = modelAssetId[29]; break;\n            case footprintAssetId[30]: assetModelRule.value = modelAssetId[30]; modelNode.name = modelAssetId[30]; break;\n            case footprintAssetId[31]: assetModelRule.value = modelAssetId[31]; modelNode.name = modelAssetId[31]; break;\n            case footprintAssetId[32]: assetModelRule.value = modelAssetId[32]; modelNode.name = modelAssetId[32]; break; \n            default : assetModelRule.value = \"3DSMD_0603_1608Metric\"; modelNode.name = \"3DSMD_0603_1608Metric\"; break;\n            }\n        }\n    }\n};","part_uid":"a6e7a9d9-59c9-4a82-9f37-94984a57e63d","symbol_resource_file":"document_assets/fixed-resistor-us-9003be3c-a6c0-8314-d98f-a0a79124231c.svg","properties":{"de3f4899-a173-50a9-9ec9-6e7711429d8f":{"uid":"de3f4899-a173-50a9-9ec9-6e7711429d8f","unit":"Ω","name":"Resistance","value":"5.1k","order":0},"9238774a-4da9-9ef8-6c97-14ba7962c9b8":{"uid":"9238774a-4da9-9ef8-6c97-14ba7962c9b8","unit":"","name":"Designator Prefix","value":"R","order":6},"091cd9cc-a638-22eb-fe71-8f54318c114d":{"uid":"091cd9cc-a638-22eb-fe71-8f54318c114d","unit":"","name":"Manufacturer Name","value":"Vishay","order":6},"e08d8ec5-1c24-4aa9-a0c8-769835f002e7":{"uid":"e08d8ec5-1c24-4aa9-a0c8-769835f002e7","unit":"","name":"License","value":"https://creativecommons.org/licenses/by/4.0/","order":7},"0406b76f-b792-5b71-5c13-27e985ab4729":{"uid":"0406b76f-b792-5b71-5c13-27e985ab4729","unit":"","name":"Part Type","value":"Resistor","order":1},"f5fb6d51-0168-733a-b622-482d9bb57e7a":{"uid":"f5fb6d51-0168-733a-b622-482d9bb57e7a","name":"Datasheet URL","value":"https://www.vishay.com/docs/28773/crcwce3.pdf","order":6},"6f63c478-bfcb-89eb-4f15-84d076e7cf0b":{"uid":"6f63c478-bfcb-89eb-4f15-84d076e7cf0b","unit":"","name":"Manufacturer Part Number","value":"CRCW06035K10JNEAC","order":3},"dfa22e0a-7f6a-a9f0-7918-5ac4fd85e7d1":{"uid":"dfa22e0a-7f