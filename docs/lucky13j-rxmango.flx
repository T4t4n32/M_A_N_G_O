nt.flx_ftp","storageName":"document_assets/RA-02-Footprint-fa426685-7e11-4b73-9a43-14f0f0ef04b7.flx_ftp","uid":"d5141c37-4ea2-43d5-8358-7b83c7c60fea"},"ef2f85ca-a601-4e4a-9d9a-808041b64db8":{"fileType":"png","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":true,"label":"image.png","name":"image","rawName":"image.png","storageName":"document_assets/image-e9bac999-db68-4396-8123-6fbc381e048c.png","uid":"ef2f85ca-a601-4e4a-9d9a-808041b64db8"}},"preview_image":"document_assets/image-e9bac999-db68-4396-8123-6fbc381e048c.png","symbol_resource_file":"","symbolLayoutStrategy":"parametric-v0","properties":{"0acbb064-1a64-483f-90c9-a2ad6832d352":{"name":"Part Type","order":2,"uid":"0acbb064-1a64-483f-90c9-a2ad6832d352","value":"Integrated Circuits"},"14449c08-1224-40af-bd48-afbfdbf4576e":{"isSetBySystem":false,"name":"Part Type","order":7,"uid":"14449c08-1224-40af-bd48-afbfdbf4576e","unit":"","value":"RF Transceiver"},"144bb6f7-1cc6-4a1c-aabd-ff4937a6e81b":{"isSetBySystem":false,"name":"Datasheet URL","order":3,"uid":"144bb6f7-1cc6-4a1c-aabd-ff4937a6e81b","value":{"text":"https://mm.digikey.com/Volume0/opasdata/d220001/medias/docus/8827/RA-02.pdf","type":"link","url":"https://mm.digikey.com/Volume0/opasdata/d220001/medias/docus/8827/RA-02.pdf"}},"2082c3c7-8aec-4de2-8ee4-8e65a5beb399":{"isSetBySystem":false,"name":"Manufacturer Name","order":1,"uid":"2082c3c7-8aec-4de2-8ee4-8e65a5beb399","value":"Ai-Thinker"},"2317c9b5-fdd8-4119-b319-0c62e0b99a54":{"name":"Designator Prefix","order":4,"uid":"2317c9b5-fdd8-4119-b319-0c62e0b99a54","value":"U"},"87dc580d-b699-45a0-82de-dc09bf807869":{"name":"Mount","order":5,"uid":"87dc580d-b699-45a0-82de-dc09bf807869","value":"Surface Mount"},"bac51e55-e543-48c8-b428-9d95b1ebc540":{"name":"Package or Case Code","order":6,"uid":"bac51e55-e543-48c8-b428-9d95b1ebc540","value":"Module"},"eb161e45-900e-46bd-93a2-358ea185706e":{"isSetBySystem":false,"name":"Manufacturer Part Number","order":0,"uid":"eb161e4