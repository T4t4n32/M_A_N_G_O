_0402Metric-8e671088-fcdb-d63e-057f-1a3c766e43c8.kicad_mod","uid":"11724c97-0529-7c3e-7ec7-7b43849906eb"},"15e87bff-22cd-46d9-8646-b25620d368c5":{"fileType":"kicad_mod","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"C_Disc_D7.5mm_W2.5mm_P5.00mm.kicad_mod","name":"C_Disc_D7.5mm_W2.5mm_P5.00mm","rawName":"C_Disc_D7.5mm_W2.5mm_P5.00mm.kicad_mod","storageName":"document_assets/C_Disc_D7.5mm_W2.5mm_P5.00mm-d44fc8a4-bb20-4336-9690-7f8257de5d80.kicad_mod","uid":"15e87bff-22cd-46d9-8646-b25620d368c5"},"24ad07ca-6985-49ab-a607-a40652401c24":{"fileType":"step","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"3DC_Disc_D8.0mm_W5.0mm_P5.00mm.step","name":"3DC_Disc_D8.0mm_W5.0mm_P5.00mm","rawName":"3DC_Disc_D8.0mm_W5.0mm_P5.00mm.step","storageName":"document_assets/3DC_Disc_D8.0mm_W5.0mm_P5.00mm-c78b6f19-6473-485c-a7f6-636715e2cd89.step","uid":"24ad07ca-6985-49ab-a607-a40652401c24"},"267d21ca-937b-44f7-9afc-50bd76129e5f":{"fileType":"kicad_mod","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"CP_Radial_D5.0mm_P2.00mm.kicad_mod","name":"CP_Radial_D5.0mm_P2.00mm","rawName":"CP_Radial_D5.0mm_P2.00mm.kicad_mod","storageName":"document_assets/CP_Radial_D5.0mm_P2.00mm-34f94616-2e45-4835-befb-873a3f2d5c3f.kicad_mod","uid":"267d21ca-937b-44f7-9afc-50bd76129e5f"},"2739fae8-18f8-4a99-ab03-3e199a5c767d":{"fileType":"step","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"3DC_Disc_D9.0mm_W5.0mm_P7.50mm.step","name":"3DC_Disc_D9.0mm_W5.0mm_P7.50mm","rawName":"3DC_Disc_D9.0mm_W5.0mm_P7.50mm.step","storageName":"document_assets/3DC_Disc_D9.0mm_W5.0mm_P7.50mm-4d317300-96f3-49e2-ae45-de407529fb9d.step","uid":"2739fae8-18f8-4a99-ab03-3e199a5c767d"},"27e3bfbb-937d-9a6d-d62b-eaf48a4d3d86":{"fileType":"step","is3dModel":false,"isDefault":false,"isFootprint":false,