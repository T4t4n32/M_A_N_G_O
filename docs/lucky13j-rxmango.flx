Module"},"eb161e45-900e-46bd-93a2-358ea185706e":{"isSetBySystem":false,"name":"Manufacturer Part Number","order":0,"uid":"eb161e45-900e-46bd-93a2-358ea185706e","value":"RA-02"},"60c1758e-5e52-44b8-9583-b45f1193d1cb":{"uid":"60c1758e-5e52-44b8-9583-b45f1193d1cb","name":"Role","value":"LoRa Receiver"},"4e5db42b-5294-4552-b787-24ecfc6e8d6b":{"uid":"4e5db42b-5294-4552-b787-24ecfc6e8d6b","name":"Role Details","value":"Ai-Thinker RA-02/SX1278 410-525MHz module configured for 433MHz LoRa receive; SPI to ESP32."},"a7c86c2f-87d0-4ec8-b12e-89f595699b70":{"uid":"a7c86c2f-87d0-4ec8-b12e-89f595699b70","name":"Operating Voltage","value":3.3,"unit":"V"},"2583dcec-b072-435c-8404-99096aea6229":{"uid":"2583dcec-b072-435c-8404-99096aea6229","name":"Price","value":9.11,"unit":"USD"},"024ee34c-a002-4880-90be-e93abb97bec1":{"uid":"024ee34c-a002-4880-90be-e93abb97bec1","name":"Digi-Key Part Number","value":"RA-02"},"88b02740-e09c-475e-810d-2590bf434f29":{"uid":"88b02740-e09c-475e-810d-2590bf434f29","name":"LCSC Part Number","value":"C90039"},"2029703b-5459-4c96-a79f-d7f8951a0cc9":{"uid":"2029703b-5459-4c96-a79f-d7f8951a0cc9","name":"Purchase Url","value":"https://www.digikey.com/en/products/detail/ai-thinker/RA-02/16688840"},"55355a88-44e9-46fa-8ac8-0b837eb4d79a":{"uid":"55355a88-44e9-46fa-8ac8-0b837eb4d79a","name":"Product Info Url","value":"https://www.lcsc.com/product-detail/Wireless-Modules_SX1278LoRaWireless-Modules-Long10KM-433_C90039.html"}}},"0dd39088-ae55-4717-b68f-8f7e90ee0b78":{"uid":"0dd39088-ae55-4717-b68f-8f7e90ee0b78","label":"C1","created_at":1777766342233,"updated_at":1777766342281,"owner_uid":"ZlptFyOgRpgjoGMu10HDsDK5rgO2","part_uid":"46707925-236f-106b-e676-afa2757aa1d6","part_version":"ece39aa6-0114-41dc-961c-18207c17c302","part_version_data_cache":{"created_at":1775059712169,"part_uid":"46707925-236f-106b-e676-afa2757aa1d6","owner_uid":"BvvmCewoPEamxFYjB0c5ERKB6rt1","version":"ece39aa6-0114-41dc-961c-18207c17c302","document_import_uid":"4def8ec6-0ae5-71e2-b8e1-7398a79aec29","name":"Generic Capacitor","has_custom_name":true,"description":"A generic fixed capacitor ideal for rapid circuit topology development. You can choose between polarized and non-polarized types, its symbol and the footprint will automatically adapt based on your selection. Supported options include standard SMD sizes for ceramic capacitors (e.g., 0402, 0603, 0805), SMD sizes for aluminum electrolytic capacitors, and through-hole footprints for polarized capacitors. \n\nSave precious design time by seamlessly add more information to this part (value, footprint, etc.) as it becomes available.\n\nStandard capacitor values: 1.0pF, 10pF, 100pF, 1000pF, 0.01uF, 0.1uF, 1.0uF, 10uF, 100uF, 1000uF, 10000uF\n1.1pF, 11pF, 110pF, 1100pF\n1.2pF, 12pF, 120pF, 1200pF\n1.3pF, 13pF, 130pF, 1300pF\n1.5pF, 15pF, 150pF, 1500pF, 0.015uF, 0.15uF, 1.5uF, 15uF, 150uF, 1500uF\n1.6pF, 16pF, 160pF, 1600pF\n1.8pF, 18pF, 180pF, 1800pF\n2.0pF, 20pF, 200pF, 2000pF\n2.2pF, 22pF, 220pF, 2200pF, 0.022uF, 0.22uF, 2.2uF, 22uF, 220uF, 2200uF\n2.4pF, 24pF, 240pF, 2400pF\n2.7pF, 27pF, 270pF, 2700pF\n3.0pF, 30pF, 300pF, 3000pF\n3.3pF, 33pF, 330pF, 3300pF, 0.033uF, 0.33uF, 3.3uF, 33uF, 330uF, 3300uF\n3.6pF, 36pF, 360pF, 3600pF\n3.9pF, 39pF, 390pF, 3900pF\n4.3pF, 43pF, 430pF, 4300pF\n4.7pF, 47pF, 470pF, 4700pF, 0.047uF, 0.47uF, 4.7uF, 47uF, 470uF, 4700uF\n5.1pF, 51pF, 510pF, 5100pF\n5.6pF, 56pF, 560pF, 5600pF\n6.2pF, 62pF, 620pF, 6200pF\n6.8pF, 68pF, 680pF, 6800pF, 0.068uF, 0.68uF, 6.8uF, 68uF, 680uF, 6800uF\n7.5pF, 75pF, 750pF, 7500pF\n8.2pF, 82pF, 820pF, 8200pF\n9.1pF, 91pF, 910pF, 9100pF #generics #CommonPartsLibrary","behaviour":"// Howdy 👋.\n// If you are new to writing code in Flux make sure to check out our get started docs: https://docs.flux.ai/reference/introduction \n// We also have a Flux Slack Community in case you need help: https://www.flux.ai/p/slack-community\n// To infinity and beyond 🚀 \n\nconst p1TerminalId = \"5237503d-4662-b83a-7859-31969858b9c0\"; //P1\nconst p2TerminalId = \"e5e04a27-c5c4-f2e6-5799-708eb3f01464\"; //P2\n\nconst p1Terminal = flux.getNodeById(p1TerminalId, \"elementTerminal\");\nconst p2Terminal = flux.getNodeById(p2TerminalId, \"elementTerminal\");\n\nconst outputVoltage = flux.createOutputNode(\"vout\");\nconst inputVoltage = flux.createOutputNode(\"vin\");\nconst current = flux.createOutputNode(\"I\");\n\nconst partTypeProperty : any  = flux.properties.find((prop) => prop.name === \"Part Type\");\n\n//setup event\nflux.on(\"setup\", () => {\n    const capacitance = Number(flux.properties.find((prop) => prop.name === \"Capacitance\")?.value || 0.000001);\n    flux.simulationModel =  simModel(capacitance);\n    if (partTypeProperty) {\n        changeFluxSymbol(partTypeProperty.value);\n    }\n});\n\n// Property was changed event\nflux.on(\"propertyChange\", (event: PropertyChangeEvent) => {\n\n    if (event.property_name === \"Capacitance\") {\n        flux.notify(event.property_name + \" changed to \" + event.value + \"F\", {\n            variant: \"success\",\n        });\n        flux.simulationModel =  simModel(Number(event.value));   \n    }\n    if (event.property_name === \"Part Type\") {\n        changeFluxSymbol(event.value);\n    }\n});\n\n// Calculation Event\nflux.on(\"afterStep\", () => {\n    \n    outputVoltage.name = \"Va\";\n    outputVoltage.value = Number(p2Terminal?.voltage);\n    outputVoltage.unit = \"V\";\n    outputVoltage.displayInline = false;\n    \n    inputVoltage.name = \"Vb\";\n    inputVoltage.value = Number(p1Terminal?.voltage);\n    inputVoltage.unit = \"V\";\n    inputVoltage.displayInline = false;\n\n    current.name = \"I\";\n    current.value = Number(p1Terminal?.current);\n    current.unit = \"A\";\n    current.displayInline = false;\n\n    flux.outputs = [inputVoltage, outputVoltage, current];\n});\n\nfunction changeFluxSymbol (partTypeSelected: any) {\n    if (partTypeProperty) {\n        switch (partTypeSelected) {\n            case 'Polarized Capacitor': flux.currentSymbol = \"polarized-cap\"; break;\n            case 'Non-Polarized Capacitor': flux.currentSymbol = \"non-polarized-cap\"; break;\n            default : flux.currentSymbol = \"non-polarized-cap\"; break\n        }\n    }\n};\n\nfunction simModel(capacitance: number): CapacitorSimulationModelConfig {\n    return {\n        type: \"capacitor\",\n        capacitance: capacitance,\n        map_input_to_terminal_uid: p1TerminalId,\n        map_output_to_terminal_uid: p2TerminalId,\n    }\n};\n\nconst footprintNode = flux.getNodeById(\"400f1db7-c03a-a15d-513d-e6da15e7a2f9\") as PcbLayoutNode;\nconst modelNode = flux.getNodeById(\"7c93bbd4-43d8-8bcb-8099-3fe6995b7052\") as PcbLayoutNode;\n\n// This will return array of all assets with file type .kicad_mod\nconst footprintAssetId = flux.assets\n    .filter((asset) => asset.fileType === \"kicad_mod\") // Filter by file type\n    .map((asset) => asset.name) // Extract the name\n    .sort(); // Sort the resulting names\n\n// This will return array of all assets with file type .step\nconst modelAssetId = flux.assets\n    .filter((asset) => asset.fileType === \"step\") // Filter by file type\n    .map((asset) => asset.name) // Extract the name\n    .sort(); // Sort the resulting names\n\nif (footprintNode || modelNode) {\n    const assetFootprintRule = footprintNode.rules.find((rule) => rule.key === \"asset\");\n    const assetModelRule = modelNode.rules.find((rule) => rule.key === \"asset\");\n\n    flux.on(\"setup\", () => {\n        const property = flux.properties.find((prop) => prop.name === \"Package\");\n        if (property) {\n            changeFootprintAsset(property.value);\n            changeModelAsset(property.value)\n        }\n    });\n\n    flux.on(\"propertyChange\", (event: PropertyChangeEvent) => {\n        if (event.property_name === \"Package\") {\n            changeFootprintAsset(event.value);\n            changeModelAsset(event.value);\n            flux.notify(event.property_name + \" changed to \" + event.value, {\n                variant: \"success\",\n                });\n        }\n    });\n\n    function changeFootprintAsset(propertyValue: any) {\n        if (assetFootprintRule) {\n            const index = footprintAssetId.indexOf(propertyValue);\n            if (index >= 0 && index <= 52) {\n                assetFootprintRule.value = footprintAssetId[index];\n                footprintNode.name = footprintAssetId[index];\n            } else {\n                assetFootprintRule.value = \"SMD_0603_1608Metric\";\n                footprintNode.name = \"SMD_0603_1608Metric\";\n            }\n        }\n    };\n\n    function changeModelAsset(propertyValue: any) {\n        if (assetModelRule) {\n            const index = footprintAssetId.indexOf(propertyValue);\n            if (index >= 0 && index <= 52) {\n                assetModelRule.value = modelAssetId[index];\n                modelNode.name = modelAssetId[index];\n            } else {\n                assetModelRule.value = \"3DSMD_0603_1608Metric\";\n                modelNode.name = \"3DSMD_0603_1608Metric\";\n            }\n        }\n    };       \n};","behaviour_has_errors":false,"controls":{"_dataStructureIsArray":true},"is_original":true,"roles":{"0338f920-f103-45be-9462-2cae879caa37":{"permission":"view","created_at":1732166043008,"updated_at":1732166043009,"account_type":"user","account_uid":"0338f920-f103-45be-9462-2cae879caa37","user_uid":"0338f920-f103-45be-9462-2cae879caa37","permission_type":2},"TSQg8pog7wQ8aTjwr58QoJ8bGFQ2":{"permission":"none","created_at":1774902878583,"updated_at":1774902878583,"shared_by":"BvvmCewoPEamxFYjB0c5ERKB6rt1","account_type":"user","account_uid":"TSQg8pog7wQ8aTjwr58QoJ8bGFQ2","user_uid":"TSQg8pog7wQ8aTjwr58QoJ8bGFQ2","permission_type":0},"ZUd2OaSay9MjwJcqF85bxWUHvQU2":{"permission":"edit","created_at":1774907247934,"updated_at":1774907247934,"shared_by":"BvvmCewoPEamxFYjB0c5ERKB6rt1","account_type":"user","account_uid":"ZUd2OaSay9MjwJcqF85bxWUHvQU2","user_uid":"ZUd2OaSay9MjwJcqF85bxWUHvQU2","permission_type":1},"dQV3OMncTEVcOpwIwe1ivV70My52":{"permission":"none","created_at":1774902876650,"updated_at":1774902876650,"shared_by":"BvvmCewoPEamxFYjB0c5ERKB6rt1","account_type":"user","account_uid":"dQV3OMncTEVcOpwIwe1ivV70My52","user_uid":"dQV3OMncTEVcOpwIwe1ivV70My52","permission_type":0},"mr9oUT3ZaLfqaSBTBe3oSvWjAqU2":{"permission":"edit","created_at":1706147881031,"updated_at":1706147881032,"account_type":"user","account_uid":"mr9oUT3ZaLfqaSBTBe3oSvWjAqU2","user_uid":"mr9oUT3ZaLfqaSBTBe3oSvWjAqU2","permission_type":1},"org_b57684db-b8e9-4dc5-bcc3-cb134802db34":{"permission":"none","created_at":1732192817962,"updated_at":1774902720721,"account_type":"organization","account_uid":"org_b57684db-b8e9-4dc5-bcc3-cb134802db34","user_uid":"org_b57684db-b8e9-4dc5-bcc3-cb134802db34","permission_type":0}},"behaviour_is_derived":false,"terminals":{"5237503d-4662-b83a-7859-31969858b9c0":{"uid":"5237503d-4662-b83a-7859-31969858b9c0","name":"P1","type":"","pin_number":"1","position":{"x":-16,"y":0}},"e5e04a27-c5c4-f2e6-5799-708eb3f01464":{"uid":"e5e04a27-c5c4-f2e6-5799-708eb3f01464","name":"P2","type":"","pin_number":"2","position":{"x":16,"y":0}}},"assets":{"00f82df6-a699-40bc-99bc-b3e3305afb19":{"fileType":"step","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"3DSMD_01005_0402Metric.step","name":"3DSMD_01005_0402Metric","rawName":"3DSMD_01005_0402Metric.step","storageName":"document_assets/3DSMD_01005_0402Metric-08ce5a4c-ff5c-5984-c49a-51ddd4c85dbb.step","uid":"00f82df6-a699-40bc-99bc-b3e3305afb19"},"03019d1f-c77d-4d3d-b166-9e39a3cc09d7":{"fileType":"step","is3dModel":false,"isDefault":false,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"3DCP_Radial_D4.0mm_P1.50mm.step","name":"3DCP_Radial_D4.0mm_P1.50mm","rawName":"3DCP_Radial_D4.0mm_P1.50mm.step","storageName":"document_assets/3DCP_Radial_D4.0mm_P1.50mm-fb74a2ae-7a40-4dbb-90ad-146eca62b6c5.step","uid":"03019d1f-c77d-4