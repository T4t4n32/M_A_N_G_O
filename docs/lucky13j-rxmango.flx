otprint":false,"isPcbBoardShape":false,"rawName":"R_Axial_DIN0309_L9.0mm_D3.2mm_P25.40mm_Horizontal.kicad_mod","fileType":"kicad_mod","storageName":"document_assets/R_Axial_DIN0309_L9.0mm_D3.2mm_P25.40mm_Horizontal-34613314-ebe2-b283-f9e5-1cefcbab118c.kicad_mod"},"e2956ce7-74da-2210-cd70-c67b06a81d9c":{"uid":"e2956ce7-74da-2210-cd70-c67b06a81d9c","is3dModel":false,"isDefault":false,"name":"3DSMD_0815_2038Metric","isThumbnail":false,"label":"3DSMD_0815_2038Metric.step","isFootprint":false,"isPcbBoardShape":false,"rawName":"3DSMD_0815_2038Metric.step","fileType":"step","storageName":"document_assets/3DSMD_0815_2038Metric-102faecf-faa3-9fd7-4db2-c5d4ae34ea3a.step"},"255137af-60bc-9eb8-4f4f-e287dd158ab6":{"uid":"255137af-60bc-9eb8-4f4f-e287dd158ab6","is3dModel":false,"isDefault":false,"name":"SMD_1210_3225Metric","isThumbnail":false,"label":"SMD_1210_3225Metric.kicad_mod","isPcbBoardShape":false,"isFootprint":false,"rawName":"SMD_1210_3225Metric.kicad_mod","fileType":"kicad_mod","storageName":"document_assets/SMD_1210_3225Metric-9e91e45e-92c4-73fd-8f4b-dbfc984aae47.kicad_mod"},"d2f5533c-79ed-f449-dc11-d922d4293648":{"uid":"d2f5533c-79ed-f449-dc11-d922d4293648","is3dModel":false,"isDefault":false,"name":"SMD_1206_3216Metric","isThumbnail":false,"label":"SMD_1206_3216Metric.kicad_mod","isFootprint":false,"isPcbBoardShape":false,"rawName":"SMD_1206_3216Metric.kicad_mod","fileType":"kicad_mod","storageName":"document_assets/SMD_1206_3216Metric-bf803445-3941-2e78-cc98-fc5bab257cb4.kicad_mod"},"837c10ca-cfac-fdc0-5f72-37960e850c0b":{"uid":"837c10ca-cfac-fdc0-5f72-37960e850c0b","is3dModel":false,"isDefault":false,"name":"V_AXIAL-P5.08_D4.5","isThumbnail":false,"label":"V_AXIAL-P5.08_D4.5.kicad_mod","isPcbBoardShape":false,"isFootprint":false,"rawName":"V_AXIAL-P5.08_D4.5.kicad_mod","fileType":"kicad_mod","storageName":"document_assets/V_AXIAL-P5.08_D4.5-fd2a99d8-6449-1420-9417-524d3cbca681.kicad_mod"},"d51824d6-6d1e-dc17-b574-e57ddc53c1fc":{"uid":"d51824d6-6d1e-dc17-b574-e57dd